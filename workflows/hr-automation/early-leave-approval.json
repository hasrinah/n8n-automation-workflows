    {
      "parameters": {
        "jsCode": "// n8n Code node (JavaScript)\n\nfunction safeText(v) {\n  if (v === null || v === undefined) return \"\";\n  return String(v).trim();\n}\n\nfunction joinArray(arr) {\n  if (!Array.isArray(arr)) return \"\";\n  return arr.map(x => safeText(x)).filter(Boolean).join(\" / \");\n}\n\n// Accept array OR string, and also try alternate field names\nfunction getWorkingHours(body) {\n  const candidates = [\n    body.workinghours,\n    body.working_hours,\n    body[\"working hours\"],\n    body[\"Working Hours\"],\n  ];\n\n  for (const c of candidates) {\n    if (Array.isArray(c) && c.length) return joinArray(c);\n    if (typeof c === \"string\" && safeText(c)) return safeText(c);\n  }\n  return \"\";\n}\n\n// ---- main ----\nconst input = items[0].json || {};\nconst body = input.body || {};\n\n// Unique submission id\nconst executionId = safeText($execution.id);\nconst now = new Date();\nconst isoNow = now.toISOString();\nconst submission_id = executionId ? executionId : `SUB-${Date.now()}`;\n\n// Fields\nconst employeename = safeText(body.employeename);\nconst contactno    = safeText(body.contactno);\nconst position     = safeText(body.position);\nconst superior     = safeText(body.superior);\nconst reason       = safeText(body.reason);\nconst replacement  = safeText(body.replacement);\nconst replacement_comment = safeText(body.replacement_comment);\n\n// Working hours (FIXED)\nconst workinghours = getWorkingHours(body);\n\n// Deadline +2 days\nconst deadlineDate = new Date(now.getTime() + 2 * 24 * 60 * 60 * 1000);\nconst deadline_iso = deadlineDate.toISOString();\nconst deadline_display = deadlineDate.toLocaleString(\"en-GB\", {\n  day: \"2-digit\",\n  month: \"short\",\n  year: \"numeric\",\n  hour: \"2-digit\",\n  minute: \"2-digit\",\n  hour12: false,\n});\n\nreturn [\n  {\n    json: {\n      submission_id,\n      submitted_at_iso: isoNow,\n      employeename,\n      contactno,\n      position,\n      superior,\n      workinghours,\n      replacement,\n      \n      reason,\n      deadline_iso,\n      deadline_display,\n      approval: \"\",\n      approval_by: \"\",\n      approval_at: \"\",\n    },\n  },\n];"
      },
